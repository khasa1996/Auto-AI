APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=autoai
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PIN=replace-with-a-strong-admin-pin
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
OTP_DEMO_MODE=true

# Enable only the providers you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ELEVENLABS_API_KEY=

# S3-compatible storage for production configurator GLB assets.
# Never expose these credentials in frontend code or REACT_APP_* variables.
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_REGION=ap-south-1
ASSET_STORAGE_ENDPOINT_URL=
ASSET_STORAGE_ACCESS_KEY_ID=
ASSET_STORAGE_SECRET_ACCESS_KEY=
ASSET_STORAGE_PUBLIC_BASE_URL=
ASSET_STORAGE_UPLOAD_TTL_SECONDS=900
